# Canonical public origin, e.g. https://flow.example.com (falls back to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
# Ask Flow uses Vercel AI Gateway. On Vercel, OIDC authenticates automatically; locally set a key.
# Without credentials, Ask answers with cited source excerpts instead of a generated summary.
AI_GATEWAY_API_KEY=
# Optional Gateway model id override for Ask
ASK_MODEL=
