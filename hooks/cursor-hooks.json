{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/guard.mjs\"",
        "timeout": 15
      }
    ],
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/wip.mjs\"",
        "timeout": 5
      }
    ]
  }
}
